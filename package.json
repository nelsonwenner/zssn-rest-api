  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.17.1",
    "sequelize": "^5.21.5",
    "sqlite3": "^4.1.1",
    "yup": "^0.28.1"
  },
  "devDependencies": {
    "@sucrase/jest-plugin": "^2.0.0",
    "chai": "^4.2.0",
    "dotenv": "^8.2.0",
    "jest": "^25.1.0",
